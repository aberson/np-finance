{% extends 'main_reports/base.html.j2' %}
{% import 'main_reports/macros.html.j2' as m %}
{% block content %}
  {{ m.tiles(data.tiles) }}

  <div class="overview" id="overview">
    <div class="chart-copy">
      <h2>{% if data.target_known %}<span{% if data.of_target_partial %} class="partial"{% endif %}>{{ data.of_target }}</span> of the adopted income target{% else %}No readable adopted income target{% endif %}</h2>
      {{ m.meter(data.meter, 'Income received toward the adopted income target') }}
      <p class="chart-note">By month: {% for mo in data.months %}{{ mo.name }} <span{% if mo.unknown %} class="unk"{% elif mo.partial %} class="partial"{% endif %}>{{ mo.text }}</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>
      <p class="chart-note">Bank basis, all income categories. The marker shows how much of the school year has passed. It is not a target.</p>
    </div>
    <div class="bars" id="processors">
      <div class="bars-head"><h2>How processor money arrived</h2><span>Gross · share of all processor gross</span></div>
      <p class="sub">Processor gross by payment date. Payouts reach the bank later and are already inside bank income; never add the two.</p>
      {% if data.processors %}{{ m.bar_rows(data.routes) }}
      <p class="sub">Fees <span{% if data.combined_partial %} class="partial"{% endif %}>{{ data.fees }}</span> · Refunds <span{% if data.combined_partial %} class="partial"{% endif %}>{{ data.refunds }}</span> · Net <span{% if data.combined_partial %} class="partial"{% endif %}>{{ data.net }}</span>{% if data.excluded %} · excludes {{ data.excluded }} with no rows or coverage{% endif %}</p>
      <p class="sub"><span{% if data.combined_partial %} class="partial"{% endif %}>{{ data.attributed }}</span> of gross attributed to a category; {{ data.not_attributed }} not attributed</p>{% else %}<p class="sub">No processor source is configured or captured.</p>{% endif %}
    </div>
  </div>

  <section class="section" id="income-lines">
    {{ m.section_heading('Income lines this year', 'Adopted target and bank income to date') }}
    <div class="tablewrap"><table>
      <colgroup><col style="width:31%"><col style="width:17%"><col style="width:18%"><col style="width:34%"></colgroup>
      <thead><tr><th>Line</th><th class="amt">Target</th><th class="amt">Received to date</th><th>Can we measure it yet?</th></tr></thead>
      <tbody>
        {% for line in data.lines %}<tr><td><strong>{{ m.label(line.label) }}</strong></td>{{ m.amount(line.target) }}{{ m.amount(line.received) }}<td>{{ m.label(line.measure) }}</td></tr>{% else %}<tr><td colspan="4">No adopted income lines.</td></tr>{% endfor %}
        {% if data.other %}<tr class="other"><td>{{ data.other.text }}</td>{{ m.amount(data.other.target) }}{{ m.amount(data.other.received) }}<td></td></tr>{% endif %}
        <tr class="total"><td>All income lines</td>{{ m.amount(data.total.target) }}{{ m.amount(data.total.received) }}<td></td></tr>
      </tbody>
    </table></div>
  </section>

  <section class="section" id="followups">
    {{ m.section_heading('Data follow-ups', m.followup_qualifier(page)) }}
    {{ m.followups(page.followups) }}
  </section>
{% endblock %}
