:root{--ink:#20323f;--ink-2:#475d69;--ink-3:#71838d;--paper:#fff;--wash:#f4f8f7;--line:#ccd9d6;--deep:#123f4a;--sea:#147d83;--sun:#edb528;--go:#236c48;--go-line:#80b797;--go-tint:#edf8f1;--clr:#8a5716;--clr-line:#d7ad68;--clr-tint:#fff7e7;--ask:#74580d;--ask-line:#dbc56f;--ask-tint:#fffbe8;--stop:#922f38;--stop-line:#d5a2a8;--stop-tint:#fff1f2;--shadow:0 8px 28px rgba(26,57,67,.09);color-scheme:light}
*{box-sizing:border-box}
html{background:#e9efed;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-text-size-adjust:100%}
body{margin:0;padding:24px;background:#e9efed}
.sheet{max-width:1100px;margin:auto;background:var(--paper);padding:24px 28px 32px;box-shadow:var(--shadow)}
h1,h2,h3,p{margin:0}h1,h2,h3{color:var(--deep)}
a{color:var(--sea);text-underline-offset:3px;overflow-wrap:anywhere}
.mast{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center;border-bottom:5px solid var(--sun);padding-bottom:14px}
.logo{width:68px;height:68px;object-fit:contain}.brandmark{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:var(--deep);color:#fff;font-size:1.3rem;font-weight:800}
.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--sea);font-weight:800;overflow-wrap:anywhere}
h1{font-size:clamp(1.4rem,3vw,2rem);line-height:1.1;margin-top:3px}.sub{color:var(--ink-2);margin-top:5px;font-size:.92rem}
.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:14px}
.meta>div{border:1px solid var(--line);background:var(--wash);padding:8px 10px;min-width:0}.meta .k{font-size:.62rem;font-weight:800;letter-spacing:.075em;text-transform:uppercase;color:var(--ink-3)}.meta .v{font-size:.84rem;color:var(--ink);margin-top:2px;overflow-wrap:anywhere}
.mono{font-family:ui-monospace,"Cascadia Code",Consolas,monospace;font-size:.78em;overflow-wrap:anywhere;word-break:break-all}td.mono{word-break:normal;white-space:nowrap}
.basis{margin-top:10px;border-left:4px solid var(--sea);padding:6px 11px;background:var(--wash);font-size:.84rem;color:var(--ink-2)}
.alert{margin-top:10px;border:1px solid var(--ask-line);background:var(--ask-tint);padding:8px 12px;font-size:.84rem;color:var(--ask)}
.alert.stop{border-color:var(--stop-line);background:var(--stop-tint);color:var(--stop)}
.score{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:14px}
.box{border:1px solid var(--line);background:var(--paper);padding:9px 10px;min-width:0}.box .n{font-size:1.12rem;font-weight:800;color:var(--deep);line-height:1.2;overflow-wrap:anywhere}.box .k{font-size:.66rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);margin-top:3px}
.box.a{border-left:4px solid var(--go-line);background:var(--go-tint)}.box.a .n{color:var(--go)}
.box.c{border-left:4px solid var(--clr-line);background:var(--clr-tint)}.box.c .n{color:var(--clr)}
.box.q{border-left:4px solid var(--ask-line);background:var(--ask-tint)}.box.q .n{color:var(--ask)}
section{margin-top:22px}
.cap{border-left:5px solid var(--sea);padding:4px 0 4px 11px;margin-bottom:9px}.cap h2{font-size:1.08rem}.cap p{color:var(--ink-2);font-size:.82rem;margin-top:3px}
.tablewrap{width:100%;overflow-x:auto;border:1px solid var(--line)}
table{width:100%;border-collapse:collapse}
th{background:var(--deep);color:#fff;text-align:left;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;padding:7px 8px;vertical-align:bottom}
td{border-top:1px solid var(--line);padding:7px 8px;vertical-align:top;font-size:.82rem;overflow-wrap:anywhere}
td.amt,th.amt{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr.total td{font-weight:800;background:var(--wash);color:var(--deep)}
tr.sub td{color:var(--ink-2);background:#fafcfb}
.none,.zero{color:var(--ink-3)}
.unknown,.uncovered{color:var(--clr);font-weight:700}
.partial::after{content:" *";color:var(--clr);font-weight:800}
.chip{display:inline-block;padding:2px 7px;border-radius:999px;font-size:.62rem;font-weight:900;letter-spacing:.05em;white-space:nowrap;border:1px solid var(--line);background:var(--wash);color:var(--ink-3)}
.chip.ok{color:var(--go);background:var(--go-tint);border-color:var(--go-line)}.chip.warn{color:var(--clr);background:var(--clr-tint);border-color:var(--clr-line)}
.v-a{color:var(--go)}.v-c{color:var(--clr)}.v-d{color:var(--stop)}.v-q{color:var(--ask)}.v-n{color:var(--ink-3)}
.bridge{margin-top:12px;border:1px solid var(--line);break-inside:avoid}
.bridge h3{font-size:.9rem;padding:8px 10px;background:var(--wash)}
.bridge td.ev{font-size:.72rem;color:var(--ink-2)}
.gap{margin-top:8px}
.bridge ul{margin:4px 0 0 16px;padding:0}
.bridge .resid td{font-weight:800}.bridge .resid.off td{color:var(--stop);background:var(--stop-tint)}
.pnl th,.pnl td{padding:6px 5px;font-size:.74rem}.pnl td:first-child,.pnl th:first-child{min-width:150px}
.legend{margin-top:7px;font-size:.74rem;color:var(--ink-2)}
ul.plain{margin:6px 0 0 18px;padding:0;font-size:.82rem;color:var(--ink-2)}
.reports{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.report{border:1px solid var(--line);border-top:4px solid var(--sea);padding:11px 12px;min-width:0}.report h3{font-size:1rem}.report p{font-size:.8rem;color:var(--ink-2);margin-top:4px}.report .links{margin-top:7px;font-size:.84rem;display:flex;gap:10px;flex-wrap:wrap}
.foot{margin-top:24px;border-top:1px solid var(--line);padding-top:10px;color:var(--ink-3);font-size:.72rem}.private{font-weight:850;color:var(--stop)}
@media(max-width:720px){body{padding:0}.sheet{padding:16px 14px;box-shadow:none}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}.score{grid-template-columns:repeat(2,minmax(0,1fr))}h1{font-size:1.35rem}}
@media print{html,body{background:#fff}body{padding:0}.sheet{max-width:none;padding:0;box-shadow:none}*{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}.tablewrap{overflow:visible}tr,.box,.report{break-inside:avoid}h2,h3,.cap{break-after:avoid}}
