{% extends 'main_reports/base.html.j2' %}
{% import 'main_reports/macros.html.j2' as m %}
{% block content %}
  {{ m.tiles(data.tiles) }}

  <div class="overview" id="overview">
    <div class="chart-copy">
      <h2>Where money went</h2>
      {% if data.went %}{{ m.stack('went', data.went, 'Expense categories by share of money spent') }}{% else %}<p class="chart-note">No spending in the period.</p>{% endif %}
    </div>
    <div class="bars" id="came">
      <div class="bars-head"><h2>Where money came from</h2><span>Received · share</span></div>
      <p class="sub">Income categories on one scale, bank basis.</p>
      {% if data.came %}{{ m.bar_rows(data.came) }}{% else %}<p class="sub">No income in the period.</p>{% endif %}
    </div>
  </div>

  <section class="section" id="progress">
    <div class="section-heading"><h2>Progress against the adopted budget</h2><span>{{ data.year }}% of the year has passed · income {{ m.pct_of(data.income_meter) }} · spending {{ m.pct_of(data.expense_meter) }} of target</span></div>
    <div class="overview">
      <div>{{ m.meter(data.income_meter, 'Income received toward the adopted income target') }}</div>
      <div>{{ m.meter(data.expense_meter, 'Spending toward the adopted expense target') }}</div>
    </div>
  </section>

  <section class="section" id="lines">
    {{ m.section_heading('Largest budget lines', data.crosswalk) }}
    <div class="tablewrap"><table>
      <colgroup><col style="width:11%"><col style="width:19%"><col style="width:9%"><col style="width:9%"><col style="width:21%"><col style="width:31%"></colgroup>
      <thead><tr><th>Type</th><th>Category</th><th class="amt">Target</th><th class="amt">To date</th><th class="amt">Target less to date</th><th>Status</th></tr></thead>
      <tbody>
        {% for line in data.rows %}<tr><td>{{ m.label(line.type) }}</td><td><strong>{{ m.label(line.category) }}</strong></td>{{ m.amount(line.target) }}{{ m.amount(line.activity) }}{{ m.amount(line.remaining) }}<td>{{ m.label(line.status) }}</td></tr>{% else %}<tr><td colspan="6">No adopted lines.</td></tr>{% endfor %}
        {% if data.other %}<tr class="other"><td colspan="2">{{ data.other.text }}</td>{{ m.amount(data.other.target) }}{{ m.amount(data.other.activity) }}{{ m.amount(data.other.remaining) }}<td>{{ data.other.meta }}</td></tr>{% endif %}
      </tbody>
    </table></div>
    <p class="chart-note">{{ data.note }}</p>
  </section>

  <section class="section" id="followups">
    {{ m.section_heading('Data follow-ups', m.followup_qualifier(page)) }}
    {{ m.followups(page.followups) }}
  </section>
{% endblock %}
