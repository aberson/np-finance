{% macro freshness(rows) -%}
<div class="tablewrap"><table>
  <thead><tr><th>Source</th><th>Kind</th><th>Captured</th><th>First to last dated row</th><th>Coverage for this period</th><th>Snapshot</th></tr></thead>
  <tbody>{% for row in rows %}<tr><td>{{ row.label }}</td><td>{{ row.kind }}</td><td>{{ row.captured }}</td><td>{{ row.observed }}</td><td{% if row.partial %} class="unknown"{% endif %}>{{ row.coverage }}</td><td class="mono">{{ row.sha }}</td></tr>{% endfor %}</tbody>
</table></div>
{%- endmacro %}

{% macro bridge(item) -%}
<div class="bridge" id="bridge-{{ item.name }}">
  <h3>{{ item.title }}</h3>
  <div class="tablewrap"><table>
    <thead><tr><th>Step</th><th>Explanation</th><th class="amt">Amount</th><th>Underlying records</th></tr></thead>
    <tbody>
      <tr class="total"><td>{{ item.from_label }}</td><td>Starting total</td><td class="amt">{{ item.from_amount }}</td><td></td></tr>
      {% for row in item.rows %}<tr><td>{{ row.kind }}</td><td>{{ row.explanation }}</td><td class="amt">{{ row.amount }}</td><td class="ev">{% if row.evidence %}{{ row.evidence|length }} record{% if row.evidence|length != 1 %}s{% endif %}<ul>{% for entry in row.evidence %}<li>{{ entry }}</li>{% endfor %}</ul>{% else %}<span class="none">None linked</span>{% endif %}</td></tr>{% endfor %}
      <tr class="resid{% if not item.balanced %} off{% endif %}"><td>Unexplained residual</td><td>{% if item.balanced %}Every difference is explained.{% else %}Not explained by any recorded row; left visible.{% endif %}</td><td class="amt">{{ item.residual }}</td><td></td></tr>
      <tr class="total"><td>{{ item.to_label }}</td><td>Ending total</td><td class="amt">{{ item.to_amount }}</td><td></td></tr>
    </tbody>
  </table></div>
</div>
{%- endmacro %}

{% macro findings(f) -%}
<section id="findings">
  <div class="cap"><h2>Findings, adjustments and discrepancies</h2><p>Every limitation stays visible. Published P&amp;L control check: {{ f.control }}.</p></div>
  {% if f.issues %}<div class="tablewrap"><table><thead><tr><th>Finding</th><th class="amt">Count</th><th>Subject</th></tr></thead><tbody>{% for issue in f.issues %}<tr><td>{{ issue.code }}</td><td class="amt">{{ issue.count }}</td><td>{{ issue.subject }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="legend">No fact findings.</p>{% endif %}
  {% if f.flags %}<div class="tablewrap gap"><table><thead><tr><th>Coverage flag</th><th>Source</th><th class="amt">Count</th></tr></thead><tbody>{% for flag in f.flags %}<tr><td>{{ flag.code }}</td><td>{{ flag.source }}</td><td class="amt">{{ flag.count }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
  {% if f.warnings %}<div class="tablewrap gap"><table><thead><tr><th>Adjustment warning</th><th>Severity</th><th>Adjustment</th><th>Row</th><th>Field</th></tr></thead><tbody>{% for w in f.warnings %}<tr><td>{{ w.code }}</td><td>{{ w.severity }}</td><td class="mono">{{ w.adjustment }}</td><td>{{ w.row }}</td><td>{{ w.field }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
  <ul class="plain">
    <li>Adjustments applied: {% if f.applied %}<span class="mono">{{ f.applied|join(', ') }}</span>{% else %}none{% endif %}</li>
    <li>Adjustments effective after the as-of date: {% if f.pending %}<span class="mono">{{ f.pending|join(', ') }}</span>{% else %}none{% endif %}</li>
    <li>Adjustments superseded: {% if f.superseded %}<span class="mono">{{ f.superseded|join(', ') }}</span>{% else %}none{% endif %}</li>
    <li>Unresolved discrepancies: {% if f.discrepancies %}{{ f.discrepancies|length }} (<span class="mono">{{ f.discrepancies|join(', ') }}</span>){% else %}none{% endif %}</li>
  </ul>
</section>
{%- endmacro %}
