{% extends 'main_reports/base.html.j2' %}
{% import 'main_reports/macros.html.j2' as m %}
{% block content %}
  {{ m.tiles(data.tiles) }}

  <div class="overview" id="overview">
    <div class="progress">
      {{ m.pie('closed-share', data.pie, data.pie_title, data.closed ~ ' closed and ' ~ data.open ~ ' open of the tracked requests.') }}
      <div class="chart-copy">
        <h2>{{ data.pie_title }}</h2>
        <p class="legend"><span class="swatch" style="background:#147d83"></span>Closed · {{ data.closed }}{% if data.pie.first_pct is not none %} ({{ data.pie.first_pct }}){% endif %}</p>
        <p class="legend"><span class="swatch" style="background:#edb528"></span>Open · {{ data.open }}{% if data.pie.second_pct is not none %} ({{ data.pie.second_pct }}){% endif %}</p>
        <p class="chart-note">Share of tracked requests, by count.</p>
      </div>
    </div>
    <div class="callout">
      <h2>Paid in the period</h2>
      <p class="value">{{ data.paid }} <span>across {{ data.paid_requests }}</span></p>
      <p class="split">{{ data.matched }} matched to a bank row · {{ data.unmatched }} not yet matched</p>
      <p class="split">{{ data.prior_paid }} paid for prior-year expenses</p>
      <p class="note">Payments are placed by payment date; prior-year expenses paid this year are never added to this year's expenses.</p>
    </div>
  </div>

  <section class="section" id="open-requests">
    {{ m.section_heading('Largest open requests', 'Approved and not yet paid: ' ~ data.outstanding) }}
    <div class="tablewrap"><table>
      <colgroup><col style="width:29%"><col style="width:17%"><col style="width:13%"><col style="width:16%"><col style="width:25%"></colgroup>
      <thead><tr><th>Request</th><th>Earliest expense</th><th class="amt">Undated items</th><th class="amt">Pay now</th><th>Prior-year carryover</th></tr></thead>
      <tbody>
        {% for row in data.rows %}<tr><td><strong>{% if row.anchor %}<a class="ref" href="{{ page.queue }}#{{ row.anchor }}">{{ m.label(row.ref) }}</a>{% else %}{{ m.label(row.ref) }}{% endif %}</strong> <span class="meta">submitted {{ row.submitted }}</span></td><td>{{ row.earliest }}</td><td class="amt">{{ row.undated }}</td>{{ m.amount(row.pay_now) }}<td>{% if row.carryover %}<span class="chip warn">{{ row.carryover }}</span>{% else %}<span class="zero">No</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5">No open requests.</td></tr>{% endfor %}
        {% if data.other %}<tr class="other"><td colspan="3"><a href="{{ page.queue }}">{{ data.other.text }}</a></td>{{ m.amount(data.other.pay_now) }}<td></td></tr>{% endif %}
        <tr class="total"><td colspan="3">All open requests</td>{{ m.amount(data.total) }}<td></td></tr>
      </tbody>
    </table></div>
  </section>

  <section class="section" id="followups">
    {{ m.section_heading('Data follow-ups', m.followup_qualifier(page)) }}
    {{ m.followups(page.followups) }}
  </section>
{% endblock %}
