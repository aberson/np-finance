<!doctype html>
<html lang="en">
<head>
{% include 'main_reports/head.html.j2' %}
  <title>{{ page.title }} · {{ page.period.label }}</title>
  <style>
{% include 'main_reports/style.css.j2' %}
  </style>
</head>
{% import 'main_reports/macros.html.j2' as m %}
<body>
<main class="sheet">
  <header class="mast">
    {% if page.logo %}<img class="logo" src="{{ page.logo }}" alt="{{ page.organization }} logo">{% else %}<div class="brandmark" aria-hidden="true">$</div>{% endif %}
    <div>
      <p class="eyebrow" title="{{ page.organization }} · Private Main Report Set">{{ page.eyebrow }} · Private Main Report Set</p>
      <h1>{{ page.title }}</h1>
      <p class="audience">For the board</p>
    </div>
    <div class="edition">As of {{ page.as_of }}</div>
  </header>
  {% block scope %}<p class="scope"><strong>{{ page.period.label }} · {{ page.period.range }} · through {{ page.period.through }}</strong>{% if page.period.legacy %} · {{ page.period.legacy }}{% endif %} · {{ page.basis }}{% for clause in page.scope_extra %} · {{ clause }}{% endfor %}</p>{% endblock %}
  {% block content %}{% endblock %}
  {% block tail %}
  {% if page.legend %}<p class="chart-note marks">– Unknown: no declared coverage or no readable amount, never zero. * Partial: incomplete coverage or an unreadable target. $0 is an observed zero.</p>{% endif %}
  <section class="narrative"><h2>Where things stand</h2><p>{{ data.narrative }}</p></section>
  {{ m.audit(page.audit) }}
  {% endblock %}
  {{ m.footer(page) }}
</main>
{% block appendix %}{% endblock %}
</body>
</html>
