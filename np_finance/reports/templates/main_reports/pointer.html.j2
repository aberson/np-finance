<!doctype html>
<html lang="en">
<head>
{% include 'main_reports/head.html.j2' %}
  <title>Main Report Set · current run</title>
  <style>
{% include 'main_reports/style.css.j2' %}
  </style>
</head>
<body>
<main class="sheet">
  <header class="mast">
    <div class="brandmark" aria-hidden="true">$</div>
    <div>
      <p class="eyebrow">Private Main Report Set</p>
      <h1>Current published run</h1>
      <p class="audience">As of {{ page.as_of }} · published {{ page.published }}</p>
    </div>
  </header>
  <p class="scope">Run <span class="mono">{{ page.run_id }}</span> · Input set <span class="mono">{{ page.input_sha }}</span></p>
  <section class="section" id="reports">
    <div class="section-heading"><h2>Reports of this run</h2><span>One captured input set</span></div>
    <p class="chart-note">Every report was rendered from that one captured input set. Earlier runs stay in their own folders; the compatibility copies beside this page are refreshed after it.</p>
    <ul>{% for link in links %}<li><a href="{{ link.href }}">{{ link.title }}</a></li>{% endfor %}</ul>
  </section>
  <footer class="foot"><span class="private">Private financial report.</span> This page is the single current-run pointer.</footer>
</main>
</body>
</html>
